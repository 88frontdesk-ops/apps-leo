{
  "manifest_version": 3,
  "name": "Weather & UV Tracker",
  "version": "3.0",
  "description": "Hourly forecast, NWS priority weather, UV index, and astronomical data.",
  "permissions": [
    "geolocation"
  ],
  "host_permissions": [
    "https://api.weather.gov/*",
    "https://api.open-meteo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Weather Tracker"
  }
}